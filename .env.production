# Backend API URL — read by `next build`, so it must be committed.
#
# Why this file exists:
# Cloudflare "Variables and Secrets" are RUNTIME only — they are not present
# during the Workers Builds step. Without this value at build time, api-client
# short-circuits every fetch, Next.js prerenders /, /about and /catalogue as
# STATIC, and then the runtime fetch turns them dynamic — which throws
# "Page changed from static to dynamic at runtime" and returns HTTP 500.
#
# Setting it here means the fetch is attempted during the build, the pages are
# compiled as dynamic, and build and runtime agree.
#
# This is not a secret: NEXT_PUBLIC_* values are inlined into the client bundle
# and shipped to every browser.
NEXT_PUBLIC_API_URL=https://si-crafts-iwcd.onrender.com

# Public origin — read by `next build` for canonical URLs, Open Graph tags,
# sitemap.xml, robots.txt and JSON-LD. Committed for the same reason as the
# API URL above: Cloudflare's Variables and Secrets are runtime-only, so a
# value set only in the dashboard is absent when metadata is generated.
#
# This MUST name the host that actually serves the site. A canonical URL
# pointing at a domain that doesn't resolve gets followed by Google, fails, and
# the page is dropped from the index — worse than having no canonical at all.
#
# TODO: change to https://solomonislandsartsandcrafts.com.au once that domain
# is registered and pointed at the Worker. That is the only edit required —
# canonicals, OG tags and the sitemap all derive from this one value.
NEXT_PUBLIC_SITE_URL=https://si-crafts.siacrafts.workers.dev

# Backend API URL — read by `next build`, so it must be committed.
#
# Why this file exists:
# Cloudflare "Variables and Secrets" are RUNTIME only — they are not present
# during the Workers Builds step. Without this value at build time, api-client
# short-circuits every fetch, Next.js prerenders /, /about and /catalogue as
# STATIC, and then the runtime fetch turns them dynamic — which throws
# "Page changed from static to dynamic at runtime" and returns HTTP 500.
#
# Setting it here means the fetch is attempted during the build, the pages are
# compiled as dynamic, and build and runtime agree.
#
# This is not a secret: NEXT_PUBLIC_* values are inlined into the client bundle
# and shipped to every browser.
NEXT_PUBLIC_API_URL=https://si-crafts-iwcd.onrender.com

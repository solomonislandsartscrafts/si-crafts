# Backend API URL for `npm run dev`.
#
# This deliberately points at the SAME backend production uses, so what you see
# on localhost matches what visitors see. Pointing local dev at an empty or
# stopped local Django server is what caused "no images locally" and made the
# design look different from production — the grids fell back to empty states.
#
# To work against a local Django backend instead, use:
#   npm run dev:sandbox        (sets NEXT_PUBLIC_API_URL=http://localhost:8000)
# A real environment variable always overrides this file, so that script wins.
#
# Loaded ONLY when NODE_ENV=development. Never use `.env.local` for this — that
# file is loaded during production builds too and would bake localhost into the
# deployed Cloudflare Worker.
NEXT_PUBLIC_API_URL=https://si-crafts-iwcd.onrender.com

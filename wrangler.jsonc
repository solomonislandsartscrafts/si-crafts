{
  "name": "si-crafts",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "R2_BUCKET_NAME": "si-crafts-media"
  },
  // Keeps parity with the deployed production Worker, which already has this
  // binding. Git-based builds deploy strictly from this file, so omitting it
  // would strip the binding off production on the next deploy.
  "r2_buckets": [
    {
      "bucket_name": "si-crafts-media",
      "binding": "si_crafts_media"
    },
    // OpenNext ISR cache (see open-next.config.ts). A separate bucket so
    // cache entries never mix with uploaded media.
    {
      "bucket_name": "si-crafts-inc-cache",
      "binding": "NEXT_INC_CACHE_R2_BUCKET"
    }
  ],
  // Lets the revalidation queue call back into this same Worker to
  // re-render a stale page in the background.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "si-crafts"
    }
  ],
  // Background ISR revalidation queue; DOQueueHandler is exported from
  // .open-next/worker.js by the OpenNext build.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ]
}
